[Unit]
Description=Misson software service

[Service]
Type=simple
Restart=on-failure
RestartSec=2
ExecStartPre=/bin/bash -c 'echo 0 > /home/cubesat/logs/state.txt'
ExecStart=/home/cubesat/MPM-Ion0-software/Ion/bin/flightmain
StandardOutput=append:/home/cubesat/logs/flightlog.log
StandardError=append:/home/cubesat/logs/flightlog.log

[Install]
WantedBy=multi-user.target
