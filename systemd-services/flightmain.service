[Unit]
Description=Ion0 OLAF Main Application
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/cubesat/MPM-Ion0-software/Ion
ExecStart=/home/cubesat/.local/bin/uv run /home/cubesat/MPM-Ion0-software/Ion/src/ion/main.py
